{
  "name": "deskcue",
  "version": "0.2.0",
  "description": "DeskCue：每日关注、本人推进、等待外部的 Windows 桌面事项提醒工具",
  "main": "main.js",
  "author": "DeskCue contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gemini-yzc/deskcue.git"
  },
  "homepage": "https://github.com/Gemini-yzc/deskcue#readme",
  "bugs": {
    "url": "https://github.com/Gemini-yzc/deskcue/issues"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "dist": "electron-builder --win portable --x64 --publish never",
    "pack": "electron-builder --win --x64 --dir --publish never",
    "bundle": "node scripts/bundle.js"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "org.deskcue.desktop",
    "productName": "DeskCue",
    "copyright": "Copyright © 2026 DeskCue contributors; upstream © 2026 Wilkcraft",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "asarUnpack": [
      "windows-window.ps1",
      "windows-window.cs"
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.*",
      "windows-window.ps1",
      "windows-window.cs",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "DeskCue-${version}-windows-x64.exe"
    }
  }
}
